<?xml version="1.0"?>
<robot name="gripper" xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="gripper" params="parent">

    <joint name="CilindroPinza2_link_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0.00135 0.00931 -0.53102"/>
      <parent link="${parent}"/>
      <child link="CilindroPinza2_link"/>
    </joint>

    <joint name="Pinza1_link_joint" type="prismatic">
      <limit lower="-0.1" upper="0.3" effort="100.0" velocity="3.0"/>
      <origin rpy="-1.57080 0 0" xyz="-0.00065 -0.29 -0.065"/>
      <parent link="CilindroPinza2_link"/>
      <child link="Pinza1_link"/>
      <axis xyz="0 0 1"/>
    </joint>

    <joint name="Pinza2_link_joint" type="prismatic">
      <limit lower="-0.1" upper="0.3" effort="100.0" velocity="3.0"/>
      <origin rpy="1.57080 0 0" xyz="-0.00246 0.29 -0.065"/>
      <parent link="CilindroPinza2_link"/>
      <child link="Pinza2_link"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="CilindroPinza2_link">
      <visual name="CilindroPinza2">
        <material name="None"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry><cylinder radius="0.34500" length="0.04000"/></geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry><cylinder radius="0.345" length="0.04"/></geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
      </inertial>
    </link>

    <link name="Pinza1_link">
      <visual name="Pinza1">
        <material name="None"/>
        <origin rpy="1.57080 0 0" xyz="0 0.12500 0"/>
        <geometry>
          <mesh filename="package://rover_proyect/meshes/dae/Cube.011.dae" scale="0.12500 0.00681 0.20000"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="1.57080 0 0" xyz="0 0.12500 0"/>
        <geometry>
          <mesh filename="package://rover_proyect/meshes/dae/Cube.011.dae" scale="0.12500 0.00681 0.20000"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
    </link>

    <link name="Pinza2_link">
      <visual name="Pinza2">
        <material name="None"/>
        <origin rpy="1.57080 0 0" xyz="0 -0.12500 0"/>
        <geometry>
          <mesh filename="package://rover_proyect/meshes/dae/Cube.014.dae" scale="0.12500 0.00681 0.20000"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="1.57080 0 0" xyz="0 -0.12500 0"/>
        <geometry>
          <mesh filename="package://rover_proyect/meshes/dae/Cube.014.dae" scale="0.12500 0.00681 0.20000"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
    </link>
  </xacro:macro>
</robot>