<?xml version="1.0"?>
<robot name="wheels" xmlns:xacro="http://www.ros.org/xacro">

  <xacro:macro name="wheels" params="parent">

    <joint name="Axis1_link_joint" type="fixed">
      <origin rpy="0 0 -3.13536" xyz="-0.88055 0.00139 -0.08971"/>
      <parent link="${parent}"/>
      <child link="Axis1_link"/>
    </joint>

    <joint name="Axis2_link_joint" type="fixed">
      <origin rpy="0 0 -3.13536" xyz="0.05611 0.00545 -0.09470"/>
      <parent link="${parent}"/>
      <child link="Axis2_link"/>
    </joint>

    <joint name="Axis3_link_joint" type="fixed">
      <origin rpy="0 0 -3.13536" xyz="0.98860 -0.00742 -0.08702"/>
      <parent link="${parent}"/>
      <child link="Axis3_link"/>
    </joint>

    <xacro:macro name="axis" params="name mesh xyz">
      <link name="${name}_link">
        <visual>
          <origin rpy="0 0 0" xyz="${xyz}"/>
          <geometry>
            <mesh filename="${mesh}" scale="0.025 0.25 0.025"/>
          </geometry>
        </visual>
        <collision>
          <geometry><box size="0.05 1.8 0.05"/></geometry>
        </collision>
        <inertial>
          <mass value="1.0"/>
          <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
        </inertial>
      </link>
    </xacro:macro>

    <xacro:axis name="Axis1" mesh="package://rover_proyect/meshes/dae/Cube.005.dae" xyz="-0.22252 -0.22955 -0.00816"/>
    <xacro:axis name="Axis2" mesh="package://rover_proyect/meshes/dae/Cube.006.dae" xyz="-0.22275 -0.22549 -0.00317"/>
    <xacro:axis name="Axis3" mesh="package://rover_proyect/meshes/dae/Cube.008.dae" xyz="-0.21856 -0.23838 -0.01085"/>

    <xacro:macro name="wheel" params="name parent xyz rpy mesh flip">

      <joint name="${name}_joint" type="continuous">
        <limit effort="100.0" velocity="20.0"/>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <parent link="${parent}"/>
        <child link="${name}_link"/>
        <axis xyz="0 0 1"/>
      </joint>

      <link name="${name}_link">
        <visual>
          <origin xyz="0 0 0" rpy="${flip}"/>
          <geometry>
            <mesh filename="${mesh}" scale="0.2 0.2 0.6"/>
          </geometry>
        </visual>
        <collision>
          <geometry><cylinder radius="0.18" length="0.15"/></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.000000</mu>
                <mu2>1.000000</mu2>
                <fdir1>0.000000 0.000000 1.000000</fdir1>
                <slip1>0.500000</slip1>
                <slip2>0.500000</slip2>
              </ode>
            </friction>
          </surface>
        </collision>
        <inertial>
          <mass value="2.0"/>
          <inertia ixx="0.05" iyy="0.05" izz="0.05" ixy="0" ixz="0" iyz="0"/>
        </inertial>
      </link>

      <transmission name="${name}_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="${name}_joint">
          <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
        </joint>
        <actuator name="${name}_motor">
          <mechanicalReduction>1</mechanicalReduction>
        </actuator>
      </transmission>

      <gazebo reference="${name}_link">
        <mu1>5.0</mu1>
        <mu2>5.0</mu2>
      </gazebo>

    </xacro:macro>


    <xacro:wheel name="Rueda1Drcha" parent="Axis1_link"
                 xyz="-0.22424 -0.82753 -0.20939"
                 rpy="1.57080 0 0"
                 mesh="package://rover_proyect/meshes/dae/Torus.003.dae"
                 flip="0 0 0"/>

    <xacro:wheel name="Rueda1Izq" parent="Axis1_link"
                 xyz="-0.21372 0.86399 -0.20801"
                 rpy="-1.57080 0 3.13536"
                 mesh="package://rover_proyect/meshes/dae/Torus.dae"
                 flip="3.14159 0 0"/>

    <xacro:wheel name="Rueda2Drcha" parent="Axis2_link"
                 xyz="-0.22447 -0.82347 -0.20439"
                 rpy="1.57080 0 0"
                 mesh="package://rover_proyect/meshes/dae/Torus.005.dae"
                 flip="0 0 0"/>

    <xacro:wheel name="Rueda2Izq" parent="Axis2_link"
                 xyz="-0.21395 0.86806 -0.20301"
                 rpy="-1.57080 0 3.13536"
                 mesh="package://rover_proyect/meshes/dae/Torus.004.dae"
                 flip="3.14159 0 0"/>

    <xacro:wheel name="Rueda3Drcha" parent="Axis3_link"
                 xyz="-0.22028 -0.83636 -0.21208"
                 rpy="1.57080 0 0"
                 mesh="package://rover_proyect/meshes/dae/Torus.009.dae"
                 flip="0 0 0"/>

    <xacro:wheel name="Rueda3Izq" parent="Axis3_link"
                 xyz="-0.20976 0.85516 -0.21070"
                 rpy="-1.57080 0 3.13536"
                 mesh="package://rover_proyect/meshes/dae/Torus.008.dae"
                 flip="3.14159 0 0"/>

  </xacro:macro>

</robot>