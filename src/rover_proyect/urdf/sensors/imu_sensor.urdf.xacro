<?xml version="1.0"?>
<robot name="imu_sensor" xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="imu_sensor" params="prefix topic parent_link xyz rpy">

    <joint name="${prefix}_joint" type="fixed">
      <origin rpy="${rpy}" xyz="${xyz}"/>
      <parent link="${parent_link}"/>
      <child link="${prefix}_link"/>
    </joint>

    <link name="${prefix}_link">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry><box size="0.05 0.05 0.02"/></geometry>
        <material name="imu_color">
          <color rgba="0.0 0.8 0.0 1.0"/>
        </material>
      </visual>
      <inertial>
        <mass value="0.05"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <gazebo reference="${prefix}_link">
      <sensor name="${prefix}_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>${topic}</topic>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>